        ],
        "partitions": [
          {
            "name": "Contrôle Excel",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Noms = NomsDesMois,",
                "    MoisCourt = (d as nullable date) as text =>",
                "        if d = null then \"\" else Noms[Courts]{Date.Month(d) - 1} & \" \" & Text.From(Date.Year(d)),",
                "    // indicateurs : Calculs!AK4:AL40 (libellé | valeur), lus par position",
                "    Indicateurs = Table.SelectColumns(fnLireNom(\"bi_Indicateurs\"), {\"Column1\", \"Column2\"}, MissingField.UseNull),",
                "    IndSansErreurs = Table.ReplaceErrorValues(Indicateurs, {{\"Column1\", null}, {\"Column2\", null}}),",
                "    IndNumérotés = Table.AddIndexColumn(IndSansErreurs, \"Ligne\", 4, 1, Int64.Type),",
                "    Comparés = #table(type table [Ligne = Int64.Type, Code = text, Nature = text, Tolérance = number], {",
                "        {4, \"total\", \"Heures\", 0.01},",
                "        {5, \"nbAff\", \"Nombre\", 0.001},",
                "        {6, \"nbChefs\", \"Nombre\", 0.001},",
                "        {7, \"nbProj\", \"Nombre\", 0.001},",
                "        {8, \"nbTypes\", \"Nombre\", 0.001},",
                "        {9, \"realise\", \"Heures\", 0.01},",
                "        {10, \"reste\", \"Heures\", 0.01},",
                "        {11, \"avgSimple\", \"Pourcentage\", 0.0001},",
                "        {12, \"avgPond\", \"Pourcentage\", 0.0001},",
                "        {13, \"autoStart\", \"Mois\", 0},",
                "        {14, \"start\", \"Mois\", 0},",
                "        {15, \"periode\", \"Heures\", 0.01},",
                "        {16, \"hors\", \"Heures\", 0.01},",
                "        {17, \"pic\", \"Heures\", 0.01},",
                "        {19, \"picMois\", \"Mois\", 0},",
                "        {20, \"picActives\", \"Nombre\", 0.001},",
                "        {21, \"picETP\", \"Décimal\", 0.001},",
                "        {22, \"totalETP\", \"Décimal\", 0.001},",
                "        {24, \"nbTermines\", \"Nombre\", 0.001},",
                "        {25, \"finPeriode\", \"Mois\", 0},",
                "        {26, \"picPart\", \"Pourcentage\", 0.0001},",
                "        {27, \"periodeTxt\", \"Texte\", 0},",
                "        {33, \"capEquipe\", \"Heures\", 0.01},",
                "        {34, \"nbSurcharge\", \"Nombre\", 0.001},",
                "        {35, \"premSurcharge\", \"Mois\", 0},",
                "        {36, \"picCap\", \"Pourcentage\", 0.0001},",
                "        {37, \"nbRetard\", \"Nombre\", 0.001},",
                "        {38, \"nbDepasse\", \"Nombre\", 0.001},",
                "        {39, \"nbEcart\", \"Nombre\", 0.001},",
                "        {40, \"reglagesTxt\", \"Texte\", 0}",
                "    }),",
                "    Joints = Table.NestedJoin(Comparés, {\"Ligne\"}, IndNumérotés, {\"Ligne\"}, \"Excel\", JoinKind.LeftOuter),",
                "    Développés = Table.ExpandTableColumn(Joints, \"Excel\", {\"Column1\", \"Column2\"}, {\"Libellé Excel\", \"Valeur brute\"}),",
                "    LignesIndicateurs = Table.FromRecords(List.Transform(Table.ToRecords(Développés), (r) => [",
                "        Ordre = r[Ligne],",
                "        Catégorie = \"Indicateurs\",",
                "        // libellé unique (colonne triée par Ordre) même si la cellule de l'onglet Calculs est vide",
                "        Contrôle = let l = fnTexteExcel(r[#\"Libellé Excel\"]) in if l = \"\" then \"Indicateur \" & r[Code] else l,",
                "        Code = r[Code],",
                "        Nature = r[Nature],",
                "        #\"Cellule Excel\" = \"Calculs!AL\" & Text.From(r[Ligne]),",
                "        #\"Mois\" = if r[Nature] = \"Mois\" then fnDateExcel(r[#\"Valeur brute\"]) else null,",
                "        #\"Valeur lue\" = if r[Nature] = \"Mois\" or r[Nature] = \"Texte\" then null else fnNombreExcel(r[#\"Valeur brute\"]),",
                "        #\"Valeur lue (texte)\" =",
                "            if r[Nature] = \"Texte\" then fnTexteExcel(r[#\"Valeur brute\"])",
                "            else if r[Nature] = \"Mois\" then MoisCourt(fnDateExcel(r[#\"Valeur brute\"]))",
                "            else null,",
                "        Tolérance = r[Tolérance]",
                "    ]), type table [Ordre = Int64.Type, Catégorie = text, Contrôle = text, Code = text, Nature = text,",
                "        #\"Cellule Excel\" = text, Mois = nullable date, #\"Valeur lue\" = nullable number,",
                "        #\"Valeur lue (texte)\" = nullable text, Tolérance = number]),",
                "    // charge des 12 mois affichés : Calculs!AO4:AP15 (mois | charge)",
                "    MoisExcel = Table.SelectColumns(fnLireNom(\"bi_Mois\"), {\"Column1\", \"Column2\"}, MissingField.UseNull),",
                "    MoisSansErreurs = Table.ReplaceErrorValues(MoisExcel, {{\"Column1\", null}, {\"Column2\", null}}),",
                "    MoisNumérotés = Table.AddIndexColumn(MoisSansErreurs, \"N°\", 1, 1, Int64.Type),",
                "    LignesMois = Table.FromRecords(List.Transform(Table.ToRecords(MoisNumérotés), (r) => [",
                "        Ordre = 100 + r[#\"N°\"],",
                "        Catégorie = \"Charge par mois\",",
                "        Contrôle = \"Mois \" & Text.PadStart(Text.From(r[#\"N°\"]), 2, \"0\") & \" : \" & MoisCourt(fnDateExcel(r[Column1])),",
                "        Code = \"mois\",",
                "        Nature = \"Heures\",",
                "        #\"Cellule Excel\" = \"Calculs!AP\" & Text.From(r[#\"N°\"] + 3),",
                "        #\"Mois\" = fnDateExcel(r[Column1]),",
                "        #\"Valeur lue\" = fnNombreExcel(r[Column2]),",
                "        #\"Valeur lue (texte)\" = null,",
                "        Tolérance = 0.01",
                "    ]), Value.Type(LignesIndicateurs)),",
                "    Résultat = Table.Combine({LignesIndicateurs, LignesMois}),",
                "    Sélection = Table.SelectColumns(Résultat, {\"Ordre\", \"Catégorie\", \"Contrôle\", \"Code\", \"Nature\", \"Cellule Excel\", \"Mois\", \"Valeur lue\", \"Valeur lue (texte)\", \"Tolérance\"}, MissingField.UseNull),",
                "    Typée = Table.TransformColumnTypes(Sélection, {{\"Ordre\", Int64.Type}, {\"Catégorie\", type text}, {\"Contrôle\", type text}, {\"Code\", type text}, {\"Nature\", type text}, {\"Cellule Excel\", type text}, {\"Mois\", type date}, {\"Valeur lue\", type number}, {\"Valeur lue (texte)\", type text}, {\"Tolérance\", type number}})",
                "in",
                "    Typée"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
      {
        "name": "Mesures",
        "description": "Table des mesures du rapport.",
        "lineageTag": "f017435f-907f-5598-9132-dfb1bd165310",
        "columns": [
          {
            "name": "Colonne technique",
            "dataType": "string",
            "sourceColumn": "Colonne technique",
            "lineageTag": "37c93842-08ba-58c9-bcf5-b7a6f7c5855f",
            "isHidden": true,
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Mesures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Résultat = #table(type table [#\"Colonne technique\" = text], {}),",
                "    Sélection = Table.SelectColumns(Résultat, {\"Colonne technique\"}, MissingField.UseNull),",
                "    Typée = Table.TransformColumnTypes(Sélection, {{\"Colonne technique\", type text}})",
                "in",
                "    Typée"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ],
        "measures": [
          {
            "name": "Charge identifiée (h)",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( SUM ( Lignes[Heures (h)] ), 'Périmètre'[Périmètre] = _p ) + 0"
            ],
            "lineageTag": "cbaa2225-668c-5a43-abc2-a980cf0ef953",
            "displayFolder": "Charge",
            "description": "Somme des heures des lignes du périmètre (onglet Charge, colonne M).",
            "formatString": "#,0"
          },
          {
            "name": "Réalisé (h)",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( SUM ( Lignes[Réalisé de la ligne (h)] ), 'Périmètre'[Périmètre] = _p ) + 0"
            ],
            "lineageTag": "0ca17276-0a4b-572f-8cbf-29d8ca697236",
            "displayFolder": "Charge",
            "description": "Heures × avancement des lignes du périmètre.",
            "formatString": "#,0"
          },
          {
            "name": "Reste à faire (h)",
            "expression": "[Charge identifiée (h)] - [Réalisé (h)]",
            "lineageTag": "3f08a608-9524-55cb-9d0c-ea924311c7a8",
            "displayFolder": "Charge",
            "description": "Charge identifiée - réalisé.",
            "formatString": "#,0"
          },
          {
            "name": "Capacité projets par personne (h/mois)",
            "expression": "MAX ( 'Réglages'[Capacité projets par personne (Excel)] )",
            "lineageTag": "c07c4816-6e8c-5f5d-bb7d-9c03d4e78e44",
            "displayFolder": "Charge",
            "description": "Capacité par défaut - charge fixe par défaut (réglages du Dashboard Excel).",
            "formatString": "#,0"
          },
          {
            "name": "ETP-mois",
            "expression": [
              "VAR _c = [Capacité projets par personne (h/mois)]",
              "RETURN",
              "    IF ( _c <= 0, 0, DIVIDE ( [Charge identifiée (h)], _c ) )"
            ],
            "lineageTag": "60472b47-74c1-527d-ba70-d9426812507b",
            "displayFolder": "Charge",
            "description": "Charge identifiée / (capacité - charge fixe) d'une personne (0 si diviseur <= 0).",
            "formatString": "0.0"
          },
          {
            "name": "Nombre de chefs de projet",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( DISTINCTCOUNT ( Lignes[Chef de projet] ), 'Périmètre'[Périmètre] = _p ) + 0"
            ],
            "lineageTag": "4b19b436-f165-5bc2-8dab-4d1c0755d610",
            "displayFolder": "Charge",
            "description": "Chefs distincts des lignes du périmètre.",
            "formatString": "0"
          },
          {
            "name": "Nombre de projets",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( DISTINCTCOUNT ( Lignes[Projet] ), 'Périmètre'[Périmètre] = _p ) + 0"
            ],
            "lineageTag": "39ca550a-e0cf-5aee-b8c5-ef7f10262180",
            "displayFolder": "Charge",
            "description": "Projets distincts (casse ignorée).",
            "formatString": "0"
          },
          {
            "name": "Nombre de types",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( DISTINCTCOUNT ( Lignes[Type] ), 'Périmètre'[Périmètre] = _p ) + 0"
            ],
            "lineageTag": "4dacf85a-3961-584d-b4c5-aef78d263318",
            "displayFolder": "Charge",
            "description": "Types d'affaire distincts.",
            "formatString": "0"
          },
          {
            "name": "Nombre de lignes",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( Lignes ), 'Périmètre'[Périmètre] = _p ) + 0"
            ],
            "lineageTag": "7f56269b-a031-54e0-8088-3bdaa1149a3d",
            "displayFolder": "Charge",
            "description": "Lignes de l'onglet Charge dans le périmètre.",
            "formatString": "0"
          },
          {
            "name": "Part de la charge (%)",
            "expression": "DIVIDE ( [Charge identifiée (h)], CALCULATE ( [Charge identifiée (h)], ALLSELECTED () ) )",
            "lineageTag": "f4162931-46af-5940-9861-26b70f612fc1",
            "displayFolder": "Charge",
            "description": "Part de la charge identifiée dans le total de la sélection (segments et filtres de la page).",
            "formatString": "0.0 %"
          },
          {
            "name": "Nombre d'affaires",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( Affaires ), 'Périmètre'[Périmètre] = _p ) + 0"
            ],
            "lineageTag": "24d4c26c-ec41-54a6-bb88-17ba2bb44d73",
            "displayFolder": "Affaires",
            "description": "Affaires (sous-projets regroupés) ayant au moins une ligne dans le périmètre.",
            "formatString": "0"
          },
          {
            "name": "Affaire choisie",
            "expression": "IF ( CALCULATE ( DISTINCTCOUNT ( Affaires[Affaire] ), ALLSELECTED () ) = 1, 1, 0 )",
            "lineageTag": "da6ef0d1-674b-5cfc-8d4a-740ffb5f6e17",
            "displayFolder": "Affaires",
            "description": "1 si les filtres extérieurs au visuel (extraction, segments) ne laissent qu'une affaire, sinon 0 : filtre des visuels de la fiche affaire ouverte sans extraction.",
            "formatString": "0"
          },
          {
            "name": "Message fiche affaire",
            "expression": [
              "IF ( [Affaire choisie] = 1, \"\",",
              "    \"Aucune affaire choisie : ouvrir cette fiche par clic droit sur une affaire > Extraire > Fiche affaire.\" )"
            ],
            "lineageTag": "ab72ac3a-fc9a-58d9-86e6-382caaf6391a",
            "displayFolder": "Affaires",
            "description": "Consigne affichée quand la fiche affaire est ouverte sans extraction."
          },
          {
            "name": "Avancement moyen simple",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE (",
              "        VAR _n = COUNTROWS ( Affaires )",
              "        RETURN IF ( _n = 0, 0, DIVIDE ( SUM ( Affaires[Avancement] ), _n ) ),",
              "        'Périmètre'[Périmètre] = _p",
              "    )"
            ],
            "lineageTag": "1d3b001b-dbe0-5560-9247-ef2af00f8a91",
            "displayFolder": "Affaires",
            "description": "Moyenne simple des avancements des affaires.",
            "formatString": "0 %"
          },
          {
            "name": "Avancement moyen pondéré",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE (",
              "        VAR _h = SUM ( Affaires[Heures toutes lignes (h)] )",
              "        RETURN IF ( _h = 0, [Avancement moyen simple], DIVIDE ( SUM ( Affaires[Réalisé toutes lignes (h)] ), _h ) ),",
              "        'Périmètre'[Périmètre] = _p",
              "    )"
            ],
            "lineageTag": "f38d38b8-4585-580e-a5b9-48b6eeb3fcab",
            "displayFolder": "Affaires",
            "description": "Réalisé / heures de toutes les lignes des affaires du périmètre (repli : moyenne simple).",
            "formatString": "0 %"
          },
          {
            "name": "Affaires en retard",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( Affaires ), 'Périmètre'[Périmètre] = _p, KEEPFILTERS ( Affaires[Retard] > 0 ) ) + 0"
            ],
            "lineageTag": "75bed39d-8de3-5f67-857e-1db683bd98cf",
            "displayFolder": "Affaires",
            "description": "Affaires hors délai ou en écart de plus de 15 points.",
            "formatString": "0"
          },
          {
            "name": "Affaires hors délai",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( Affaires ), 'Périmètre'[Périmètre] = _p, KEEPFILTERS ( Affaires[Retard] = 2 ) ) + 0"
            ],
            "lineageTag": "db68d811-9729-526f-9c57-dc93d7237da8",
            "displayFolder": "Affaires",
            "description": "Date de besoin dépassée sans être à 100 %.",
            "formatString": "0"
          },
          {
            "name": "Affaires en écart",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( COUNTROWS ( Affaires ), 'Périmètre'[Périmètre] = _p, KEEPFILTERS ( Affaires[Retard] = 1 ) ) + 0"
            ],
            "lineageTag": "8582683e-0d5f-5030-ab9c-0f3c56df4f9c",
            "displayFolder": "Affaires",
            "description": "Avancement inférieur de plus de 15 points à l'avancement attendu.",
            "formatString": "0"
          },
          {
            "name": "Plus gros reste à faire (h)",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
