          },
          {
            "name": "Aujourd'hui",
            "dataType": "dateTime",
            "sourceColumn": "Aujourd'hui",
            "lineageTag": "ef1ae4f9-f12d-54c7-a98c-7fa6c329ba10",
            "formatString": "dd/mm/yyyy",
            "summarizeBy": "none",
            "description": "Date utilisée pour l'avancement attendu et les retards.",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              },
              {
                "name": "UnderlyingDateTimeDataType",
                "value": "Date"
              }
            ]
          },
          {
            "name": "Libellé",
            "dataType": "string",
            "sourceColumn": "Libellé",
            "lineageTag": "ef25af3c-dedc-57ff-8e2f-e2d5c6a0c972",
            "summarizeBy": "none",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "User"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Actualisation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Heure = HeureParis,",
                "    Deux = (n as number) as text => Text.PadStart(Text.From(n), 2, \"0\"),",
                "    Libellé = \"Données lues le \" & Deux(Date.Day(Heure)) & \"/\" & Deux(Date.Month(Heure)) & \"/\"",
                "        & Text.From(Date.Year(Heure)) & \" à \" & Deux(Time.Hour(Heure)) & \":\" & Deux(Time.Minute(Heure))",
                "        & \" (heure de Paris)\",",
                "    Résultat = #table({\"Actualisé le\", \"Aujourd'hui\", \"Libellé\"}, {{Heure, Date.From(Heure), Libellé}}),",
                "    Sélection = Table.SelectColumns(Résultat, {\"Actualisé le\", \"Aujourd'hui\", \"Libellé\"}, MissingField.UseNull),",
                "    Typée = Table.TransformColumnTypes(Sélection, {{\"Actualisé le\", type datetime}, {\"Aujourd'hui\", type date}, {\"Libellé\", type text}})",
                "in",
                "    Typée"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
