          },
          {
            "name": "Couleur avancement",
            "expression": "IF ( SELECTEDVALUE ( Affaires[Retard], 0 ) > 0, \"#B42318\", \"#1F2937\" )",
            "lineageTag": "0ce34356-3ca6-5b5f-ba13-9d7303cf486a",
            "displayFolder": "Affaires",
            "description": "Couleur de l'avancement d'une affaire : rouge si retard (mise en forme conditionnelle, valeur de champ)."
          },
          {
            "name": "Lignes terminées",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( Lignes ),",
              "    REMOVEFILTERS ( Affaires ),",
              "    'Périmètre'[Périmètre] = \"Tous les projets\",",
              "    KEEPFILTERS ( Lignes[Terminée] = TRUE () )",
              ") + 0"
            ],
            "lineageTag": "f28ddf63-2e42-58a9-8620-fe99d99d2cb5",
            "displayFolder": "Affaires",
            "description": "Lignes valides à 100 % de toutes les lignes, quel que soit le périmètre (comme l'Excel) ; suit les segments et clics sur les colonnes de Lignes (chef, projet, type), pas un clic sur une affaire.",
            "formatString": "0"
          },
          {
            "name": "Lignes avec dessinateur et externe",
            "expression": [
              "CALCULATE (",
              "    COUNTROWS ( Lignes ),",
              "    REMOVEFILTERS ( Affaires ),",
              "    'Périmètre'[Périmètre] = \"Tous les projets\",",
              "    KEEPFILTERS ( Lignes[Dessinateur et externe] = TRUE () )",
              ") + 0"
            ],
            "lineageTag": "e4ff551b-eab3-5ca5-b0a7-d9206ece38f2",
            "displayFolder": "Affaires",
            "description": "Lignes ayant un dessinateur ET une ressource externe (à corriger dans Charge), parmi toutes les lignes valides ; suit les segments chef, projet, type.",
            "formatString": "0"
          },
          {
            "name": "Charge répartie (h)",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "VAR _r = SELECTEDVALUE ( 'Répartition'[Répartition], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( SUM ( 'Charge mensuelle'[Heures (h)] ), 'Périmètre'[Périmètre] = _p, 'Répartition'[Répartition] = _r ) + 0"
            ],
            "lineageTag": "3f264726-aa2c-5208-8d14-fc296f057cb5",
            "displayFolder": "Mois et capacité",
            "description": "Heures réparties sur les mois du contexte (période, mois du graphique).",
            "formatString": "#,0"
          },
          {
            "name": "Charge répartie sans les mois vides (h)",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "VAR _r = SELECTEDVALUE ( 'Répartition'[Répartition], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( SUM ( 'Charge mensuelle'[Heures (h)] ), 'Périmètre'[Périmètre] = _p, 'Répartition'[Répartition] = _r )"
            ],
            "lineageTag": "8246bc53-3ae8-5761-bc38-5b9116acf406",
            "displayFolder": "Mois et capacité",
            "description": "Comme [Charge répartie (h)], mais vide (et non 0) sans heure répartie : un graphique n'affiche alors que les mois et ressources qui ont des heures.",
            "formatString": "#,0"
          },
          {
            "name": "Heures de la ligne sur la période (h)",
            "expression": "IF ( NOT ( ISEMPTY ( Lignes ) ), [Charge répartie (h)] )",
            "lineageTag": "05718460-8fac-5cbe-959e-ec0643360750",
            "displayFolder": "Mois et capacité",
            "description": "Charge répartie des lignes du contexte, 0 pour une ligne sans heure sur la période (sans date de début, 0 h, hors des mois choisis) ; vide pour une combinaison ligne × affaire qui n'existe pas.",
            "formatString": "#,0"
          },
          {
            "name": "Affaires actives",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "VAR _r = SELECTEDVALUE ( 'Répartition'[Répartition], \"Comme dans Excel\" )",
              "RETURN",
              "    CALCULATE ( DISTINCTCOUNT ( 'Charge mensuelle'[Clé affaire] ), 'Périmètre'[Périmètre] = _p, 'Répartition'[Répartition] = _r ) + 0"
            ],
            "lineageTag": "737165db-2405-5770-8403-424928e8b4bc",
            "displayFolder": "Mois et capacité",
            "description": "Affaires ayant au moins une heure répartie sur les mois du contexte.",
            "formatString": "0"
          },
          {
            "name": "Charge hors période ou sans date de début (h)",
            "expression": "MAX ( 0, ROUND ( [Charge identifiée (h)] - [Charge répartie (h)], 1 ) )",
            "lineageTag": "a0a4f83e-f8ec-507d-82c8-831a52f6ce43",
            "displayFolder": "Mois et capacité",
            "description": "Charge identifiée non répartie sur les mois sélectionnés (arrondie à 0,1 h).",
            "formatString": "#,0"
          },
          {
            "name": "Capacité projets de l'équipe (h/mois)",
            "expression": "MAX ( 'Réglages'[Capacité projets de l'équipe (Excel)] )",
            "lineageTag": "6788a21c-ad66-5053-827e-4ca4a8098399",
            "displayFolder": "Mois et capacité",
            "description": "Somme des (capacité - charge fixe) des ressources des listes Data : constante par mois (ligne pointillée).",
            "formatString": "#,0"
          },
          {
            "name": "Mois en surcharge",
            "expression": [
              "VAR _cap = ROUND ( [Capacité projets de l'équipe (h/mois)], 0 )",
              "RETURN",
              "    COUNTROWS ( FILTER ( VALUES ( Mois[Mois] ), ROUND ( [Charge répartie (h)], 0 ) > _cap ) ) + 0"
            ],
            "lineageTag": "41c7a4a1-6c76-528f-80ee-fdfa6881cf42",
            "displayFolder": "Mois et capacité",
            "description": "Mois où la charge arrondie dépasse la capacité projets arrondie.",
            "formatString": "0"
          },
          {
            "name": "Premier mois en surcharge",
            "expression": [
              "VAR _cap = ROUND ( [Capacité projets de l'équipe (h/mois)], 0 )",
              "RETURN",
              "    MINX ( FILTER ( VALUES ( Mois[Mois] ), ROUND ( [Charge répartie (h)], 0 ) > _cap ), Mois[Mois] )"
            ],
            "lineageTag": "035b13ee-5999-5726-8ce2-61ad0b6335eb",
            "displayFolder": "Mois et capacité",
            "description": "Premier mois en surcharge (vide si aucun).",
            "formatString": "mmmm yyyy"
          },
          {
            "name": "Pic de charge (h)",
            "expression": "COALESCE ( MAXX ( VALUES ( Mois[Mois] ), [Charge répartie (h)] ), 0 )",
            "lineageTag": "e381fbd2-ac68-5846-b1cc-f05eea119c0d",
            "displayFolder": "Mois et capacité",
            "description": "Charge du mois le plus chargé.",
            "formatString": "#,0"
          },
          {
            "name": "Mois du pic",
            "expression": [
              "VAR _pic = [Pic de charge (h)]",
              "RETURN",
              "    MINX ( FILTER ( VALUES ( Mois[Mois] ), [Charge répartie (h)] = _pic ), Mois[Mois] )"
            ],
            "lineageTag": "cae63644-d74a-5ec0-b5eb-04b0ebaa6a81",
            "displayFolder": "Mois et capacité",
            "description": "Mois le plus chargé (le premier en cas d'égalité).",
            "formatString": "mmmm yyyy"
          },
          {
            "name": "Affaires actives au pic",
            "expression": [
              "VAR _m = [Mois du pic]",
              "RETURN",
              "    IF ( ISBLANK ( _m ), 0, CALCULATE ( [Affaires actives], Mois[Mois] = _m ) )"
            ],
            "lineageTag": "6809195b-1b66-54ec-817b-54a60e778536",
            "displayFolder": "Mois et capacité",
            "description": "Affaires actives sur le mois le plus chargé.",
            "formatString": "0"
          },
          {
            "name": "ETP au pic",
            "expression": [
              "VAR _c = [Capacité projets par personne (h/mois)]",
              "RETURN",
              "    IF ( _c <= 0, 0, DIVIDE ( [Pic de charge (h)], _c ) )"
            ],
            "lineageTag": "f40ee84b-7cea-52cc-a11c-5e5feaf2e630",
            "displayFolder": "Mois et capacité",
            "description": "Pic / (capacité - charge fixe) d'une personne.",
            "formatString": "0.0"
          },
          {
            "name": "Pic en % de la capacité",
            "expression": [
              "VAR _cap = [Capacité projets de l'équipe (h/mois)]",
              "RETURN",
              "    IF ( _cap <= 0, BLANK (), DIVIDE ( [Pic de charge (h)], _cap ) )"
            ],
            "lineageTag": "2de1b690-81d8-5ef7-96f9-bb47d298cfce",
            "displayFolder": "Mois et capacité",
            "description": "Pic / capacité projets de l'équipe (vide si capacité nulle).",
            "formatString": "0 %"
          },
          {
            "name": "Part du pic dans la période",
            "expression": [
              "VAR _t = [Charge répartie (h)]",
              "RETURN",
              "    IF ( _t = 0, 0, DIVIDE ( [Pic de charge (h)], _t ) )"
            ],
            "lineageTag": "ac932489-a519-5b2d-bb72-bd03bdb34b56",
            "displayFolder": "Mois et capacité",
            "description": "Charge du mois de pic / charge répartie sur la période.",
            "formatString": "0 %"
          },
          {
            "name": "Premier mois affiché",
