          {
            "name": "Tolérance",
            "dataType": "double",
            "sourceColumn": "Tolérance",
            "lineageTag": "79bf15d2-b85f-572f-86fe-50dfa7d2c511",
            "formatString": "0.0000",
            "summarizeBy": "none",
            "annotations": [
