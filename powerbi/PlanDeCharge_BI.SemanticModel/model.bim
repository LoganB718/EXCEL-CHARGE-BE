          },
          {
            "name": "Capacité de la ressource (h/mois)",
            "expression": "IF ( HASONEVALUE ( Ressources[Clé ressource] ), MAX ( Ressources[Capacité (h/mois)] ) )",
            "lineageTag": "d72af02b-a87a-5c72-98d6-b4352ae213d7",
            "displayFolder": "Ressource",
            "description": "Capacité mensuelle d'une ressource (vide pour « (non affecté) » ou plusieurs ressources).",
            "formatString": "#,0"
          },
          {
            "name": "Charge fixe de la ressource (h/mois)",
            "expression": "IF ( HASONEVALUE ( Ressources[Clé ressource] ), MAX ( Ressources[Charge fixe (h/mois)] ) )",
            "lineageTag": "eb1f1162-0d7d-57f7-9116-3c2b6ace64c1",
            "displayFolder": "Ressource",
            "description": "Charge fixe hors projet d'une ressource.",
            "formatString": "#,0"
          },
          {
            "name": "Capacité projets de la ressource (h/mois)",
            "expression": "IF ( HASONEVALUE ( Ressources[Clé ressource] ), MAX ( Ressources[Capacité projets (h/mois)] ) )",
            "lineageTag": "6d8c9e72-2abc-5c8d-9e9c-687584e90a79",
            "displayFolder": "Ressource",
            "description": "max(0, capacité - charge fixe).",
            "formatString": "#,0"
          },
          {
            "name": "Charge fixe (h)",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _f ) ), _f * COUNTROWS ( VALUES ( Mois[Mois] ) ) )"
            ],
            "lineageTag": "7221133a-f617-5c93-b014-b50ae9a8ad6b",
            "displayFolder": "Ressource",
            "description": "Charge fixe de la ressource sur les mois du contexte.",
            "formatString": "#,0"
          },
          {
            "name": "Charge totale de la ressource (h)",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _f ) ), SUMX ( VALUES ( Mois[Mois] ), _f + [Charge répartie (h)] ) )"
            ],
            "lineageTag": "191db5dc-40ba-5f3c-bd41-259c2366fd9c",
            "displayFolder": "Ressource",
            "description": "Charge fixe + heures projets de la ressource.",
            "formatString": "#,0"
          },
          {
            "name": "Projets dans la capacité (h)",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "VAR _c = [Capacité de la ressource (h/mois)]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _f ) ),",
              "        SUMX (",
              "            VALUES ( Mois[Mois] ),",
              "            VAR _h = [Charge répartie (h)]",
              "            VAR _marge = _c - ROUND ( _f + _h, 0 )",
              "            RETURN IF ( _marge < 0, MAX ( 0, MIN ( _h, _c - _f ) ), _h )",
              "        )",
              "    )"
            ],
            "lineageTag": "23ffe974-a8ce-5e29-b9d0-fa04212b7eb9",
            "displayFolder": "Ressource",
            "description": "Heures projets tenant dans la capacité (bleu du graphique Excel).",
            "formatString": "#,0"
          },
          {
            "name": "Dépassement de capacité (h)",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "VAR _c = [Capacité de la ressource (h/mois)]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _f ) ),",
              "        SUMX (",
              "            VALUES ( Mois[Mois] ),",
              "            VAR _h = [Charge répartie (h)]",
              "            VAR _marge = _c - ROUND ( _f + _h, 0 )",
              "            RETURN _h - IF ( _marge < 0, MAX ( 0, MIN ( _h, _c - _f ) ), _h )",
              "        )",
              "    )"
            ],
            "lineageTag": "f3f91d45-9ebc-5492-b5e4-1c25284f5b42",
            "displayFolder": "Ressource",
            "description": "Heures projets au-delà de la capacité (rouge du graphique Excel).",
            "formatString": "#,0"
          },
          {
            "name": "Marge de la ressource (h)",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "VAR _c = [Capacité de la ressource (h/mois)]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _f ) ), SUMX ( VALUES ( Mois[Mois] ), _c - ROUND ( _f + [Charge répartie (h)], 0 ) ) )"
            ],
            "lineageTag": "fa916699-5946-5b02-bb3e-506cf8fa6000",
            "displayFolder": "Ressource",
            "description": "Capacité - charge totale arrondie (négatif = dépassement).",
            "formatString": "+#,0;-#,0;0"
          },
          {
            "name": "Dépassement cumulé (h)",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "VAR _c = [Capacité de la ressource (h/mois)]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _f ) ),",
              "        SUMX (",
              "            VALUES ( Mois[Mois] ),",
              "            VAR _m = _c - ROUND ( _f + [Charge répartie (h)], 0 )",
              "            RETURN IF ( _m < 0, - _m, 0 )",
              "        )",
              "    )"
            ],
            "lineageTag": "aba59214-b251-5045-a15c-f795654d26ab",
            "displayFolder": "Ressource",
            "description": "Somme des dépassements mensuels.",
            "formatString": "#,0"
          },
          {
            "name": "Heures encore disponibles (h)",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "VAR _c = [Capacité de la ressource (h/mois)]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _f ) ),",
              "        SUMX (",
              "            VALUES ( Mois[Mois] ),",
              "            VAR _m = _c - ROUND ( _f + [Charge répartie (h)], 0 )",
              "            RETURN IF ( _m > 0, _m, 0 )",
              "        )",
              "    )"
            ],
            "lineageTag": "24acfafb-3f6e-50ca-9e0f-a38dd1f8f37c",
            "displayFolder": "Ressource",
            "description": "Somme des marges mensuelles positives.",
            "formatString": "#,0"
          },
          {
            "name": "Occupation (%)",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "VAR _c = [Capacité de la ressource (h/mois)]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _f ) ),",
              "        AVERAGEX (",
              "            VALUES ( Mois[Mois] ),",
              "            VAR _t = ROUND ( _f + [Charge répartie (h)], 0 )",
              "            RETURN IF ( _c <= 0, IF ( _t > 0, 9.99, 0 ), DIVIDE ( _t, _c ) )",
              "        )",
              "    )"
            ],
            "lineageTag": "fe8e3c67-ae86-56e3-a482-7862f90eb145",
            "displayFolder": "Ressource",
            "description": "(Charge fixe + heures projets, arrondi à l'heure) / capacité ; moyenne des mois si plusieurs mois ; 999 % si capacité nulle avec de la charge.",
            "formatString": "0 %"
          },
          {
            "name": "Occupation maximale (%)",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "VAR _c = [Capacité de la ressource (h/mois)]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _f ) ),",
              "        MAXX (",
              "            VALUES ( Mois[Mois] ),",
              "            VAR _t = ROUND ( _f + [Charge répartie (h)], 0 )",
              "            RETURN IF ( _c <= 0, IF ( _t > 0, 9.99, 0 ), DIVIDE ( _t, _c ) )",
              "        )",
              "    )"
            ],
            "lineageTag": "0ab35d45-b193-5b71-9a22-c4b0d741a8fb",
            "displayFolder": "Ressource",
            "description": "Occupation du mois le plus occupé.",
            "formatString": "0 %"
          },
          {
            "name": "Couleur de fond (occupation)",
            "expression": [
              "VAR _o = [Occupation (%)]",
              "RETURN",
              "    SWITCH ( TRUE (), ISBLANK ( _o ), BLANK (), _o > 1, \"#F8D7D7\", _o >= 0.9, \"#FFF1CC\", \"#E3F4E8\" )"
            ],
            "lineageTag": "2fb737ce-9e50-53ce-8e44-ab33939b4836",
            "displayFolder": "Ressource",
            "description": "Vert < 90 %, orange 90-100 %, rouge > 100 % (fonds de l'Excel)."
          },
          {
            "name": "Couleur du texte (occupation)",
            "expression": [
              "VAR _o = [Occupation (%)]",
              "RETURN",
              "    SWITCH ( TRUE (), ISBLANK ( _o ), BLANK (), _o > 1, \"#B42318\", _o >= 0.9, \"#8A5A00\", \"#1E7B34\" )"
            ],
            "lineageTag": "e48e6e40-01bd-56f6-901a-e07da295e78f",
            "displayFolder": "Ressource",
            "description": "Texte rouge, orange foncé ou vert (couleurs de l'Excel)."
          },
          {
            "name": "Mois en surcharge de la ressource",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "VAR _c = [Capacité de la ressource (h/mois)]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _f ) ),",
              "        COUNTROWS ( FILTER ( VALUES ( Mois[Mois] ), _c - ROUND ( _f + [Charge répartie (h)], 0 ) < 0 ) ) + 0",
              "    )"
            ],
            "lineageTag": "9cb8484a-b083-560c-b80e-d242082afb3a",
            "displayFolder": "Ressource",
            "description": "Mois où la charge totale arrondie dépasse la capacité.",
            "formatString": "0"
          },
          {
            "name": "Premier mois en surcharge de la ressource",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "VAR _c = [Capacité de la ressource (h/mois)]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _f ) ),",
              "        MINX ( FILTER ( VALUES ( Mois[Mois] ), _c - ROUND ( _f + [Charge répartie (h)], 0 ) < 0 ), Mois[Mois] )",
              "    )"
            ],
            "lineageTag": "4eae8dcc-4050-5fe6-89b5-456eccd8c672",
            "displayFolder": "Ressource",
            "description": "Premier mois en surcharge (vide si aucun).",
            "formatString": "mmmm yyyy"
          },
          {
            "name": "Charge au pic de la ressource (h)",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _f ) ), MAXX ( VALUES ( Mois[Mois] ), _f + [Charge répartie (h)] ) )"
            ],
            "lineageTag": "747a41bd-8a29-516b-9a53-710ef9497b96",
            "displayFolder": "Ressource",
            "description": "Charge totale (fixe + projets) du mois le plus chargé.",
            "formatString": "#,0"
          },
          {
            "name": "Mois le plus chargé de la ressource",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "VAR _pic = [Charge au pic de la ressource (h)]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _f ) ),",
              "        MINX ( FILTER ( VALUES ( Mois[Mois] ), _f + [Charge répartie (h)] = _pic ), Mois[Mois] )",
              "    )"
            ],
            "lineageTag": "fe20dfb5-1903-5fec-aba6-0c73a4fac5ad",
            "displayFolder": "Ressource",
            "description": "Mois de charge totale maximale (le premier en cas d'égalité).",
            "formatString": "mmmm yyyy"
          },
          {
            "name": "Occupation au pic de la ressource (%)",
            "expression": [
              "VAR _m = [Mois le plus chargé de la ressource]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _m ) ), CALCULATE ( [Occupation (%)], Mois[Mois] = _m ) )"
            ],
            "lineageTag": "626c9243-e6f1-54e0-9042-fab1332bafab",
            "displayFolder": "Ressource",
            "description": "Occupation du mois le plus chargé.",
            "formatString": "0 %"
          },
          {
            "name": "Périmètre en vigueur",
            "expression": [
              "VAR _p = SELECTEDVALUE ( 'Périmètre'[Périmètre], \"Comme dans Excel\" )",
              "RETURN",
              "    LOOKUPVALUE ( 'Périmètre'[Périmètre appliqué], 'Périmètre'[Périmètre], _p )"
            ],
            "lineageTag": "0909405a-8c79-50da-aab8-c2f25f8319c0",
            "displayFolder": "Textes",
            "description": "Projets en cours ou Tous les projets."
          },
          {
            "name": "Répartition en vigueur",
            "expression": [
              "VAR _r = SELECTEDVALUE ( 'Répartition'[Répartition], \"Comme dans Excel\" )",
              "RETURN",
              "    LOOKUPVALUE ( 'Répartition'[Répartition appliquée], 'Répartition'[Répartition], _r )"
            ],
            "lineageTag": "5cad87cf-784b-5d8f-9671-739c07fb9845",
            "displayFolder": "Textes",
            "description": "Lissée jusqu'à la date de besoin ou Tout sur le mois de début."
          },
          {
            "name": "Rappel des réglages",
            "expression": [
              "[Périmètre en vigueur] & \"  ·  \"",
              "    & IF ( [Répartition en vigueur] = \"Tout sur le mois de début\", \"tout sur le mois de début\",",
              "        \"lissage en jours ouvrés jusqu'au besoin\" )",
              "    & \"  ·  \" & SELECTEDVALUE ( 'Réglages'[Rappel capacité] )"
            ],
            "lineageTag": "9e01faa3-3166-5dc1-a296-f8e7711e6353",
            "displayFolder": "Textes",
            "description": "Réglages appliqués par les segments (format du bandeau Excel)."
          },
          {
            "name": "Données lues le",
            "expression": "SELECTEDVALUE ( Actualisation[Libellé] )",
            "lineageTag": "7d898f34-2ff1-598d-8d69-6d2e87bb2185",
            "displayFolder": "Textes",
            "description": "Date et heure de l'actualisation (heure de Paris)."
          },
          {
            "name": "Titre du périmètre",
            "expression": "IF ( [Périmètre en vigueur] = \"Tous les projets\", \"TOUS LES PROJETS\", \"PROJETS EN COURS\" )",
            "lineageTag": "7271c424-1831-5fbd-8282-f3e343eda329",
            "displayFolder": "Textes",
            "description": "PROJETS EN COURS ou TOUS LES PROJETS."
          },
          {
            "name": "Sous-titre chefs",
            "expression": "IF ( [Périmètre en vigueur] = \"Tous les projets\", \"sur l'ensemble des projets\", \"sur les projets en cours\" )",
            "lineageTag": "8a8a6d5d-c63d-5f46-9fe2-004b9862e6c4",
            "displayFolder": "Textes",
            "description": "Sous-titre de la carte des chefs de projet."
          },
          {
            "name": "Sous-titre charge identifiée",
            "expression": "\"soit ≈ \" & FORMAT ( [ETP-mois], \"0.0\", \"fr-FR\" ) & \" ETP-mois\"",
            "lineageTag": "7878db3a-f0e6-55cd-b8db-5acd0431ed69",
            "displayFolder": "Textes",
            "description": "« soit ≈ x ETP-mois »."
          },
          {
            "name": "Sous-titre capacité",
            "expression": "\"Capacité projets : \" & FORMAT ( [Capacité projets de l'équipe (h/mois)], \"#,0\", \"fr-FR\" ) & \" h/mois\"",
            "lineageTag": "040613d9-3a4f-5cb4-8e70-ebf9690e2f41",
            "displayFolder": "Textes",
            "description": "« Capacité projets : x h/mois »."
          },
          {
            "name": "Sous-titre surcharge",
            "expression": [
              "VAR _m = [Premier mois en surcharge]",
              "VAR _pc = [Pic en % de la capacité]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _m ) ),",
              "        \"Dès \" & CALCULATE ( LOOKUPVALUE ( Mois[Mois (long)], Mois[Mois], _m ), REMOVEFILTERS ( Mois ) ),",
              "        IF ( ISBLANK ( _pc ), \"\", \"Pic à \" & FORMAT ( ROUND ( _pc * 100, 0 ), \"0\" ) & \" % de la capacité\" )",
              "    )"
            ],
            "lineageTag": "d05d27b7-468f-5440-b5f9-15c40e75f711",
            "displayFolder": "Textes",
            "description": "« Dès <mois> » ou « Pic à x % de la capacité »."
          },
          {
            "name": "Sous-titre pic (mois)",
            "expression": [
              "VAR _m = [Mois du pic]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _m ) ), \"en \" & CALCULATE ( LOOKUPVALUE ( Mois[Mois (long)], Mois[Mois], _m ), REMOVEFILTERS ( Mois ) ) )"
            ],
            "lineageTag": "99f3f4dc-42dc-55cd-94da-ac1ac64729d1",
            "displayFolder": "Textes",
            "description": "« en <mois du pic> »."
          },
          {
            "name": "Sous-titre pic (affaires)",
            "expression": [
              "VAR _e = ROUND ( [ETP au pic], 1 )",
              "VAR _n = [Affaires actives au pic]",
              "RETURN",
              "    _n & \" affaire(s) active(s)  ·  ≈ \"",
              "        & IF ( _e = INT ( _e ), FORMAT ( _e, \"0\" ), FORMAT ( _e, \"0.0\", \"fr-FR\" ) ) & \" ETP\""
            ],
            "lineageTag": "fb68bab0-7bc5-5b5a-b034-4aadbd06d508",
            "displayFolder": "Textes",
            "description": "« n affaire(s) active(s) · ≈ x ETP »."
          },
          {
            "name": "Sous-titre hors délai",
            "expression": "\"dont \" & [Affaires hors délai] & \" hors délai (besoin dépassé)\"",
            "lineageTag": "86e713e5-46f3-5eee-b286-8fc8d3dadab9",
            "displayFolder": "Textes",
            "description": "« dont n hors délai (besoin dépassé) »."
          },
          {
            "name": "Sous-titre écart",
            "expression": "[Affaires en écart] & \" en retard de plus de 15 pts\"",
            "lineageTag": "141d4c05-7281-53b4-b99e-0c8de20e01b2",
            "displayFolder": "Textes",
            "description": "« n en retard de plus de 15 pts »."
          },
          {
            "name": "Sous-titre projets",
            "expression": "\"réparties sur \" & [Nombre de projets] & \" projet(s)\"",
            "lineageTag": "e616abc5-bd8d-5173-a168-d3bee955cfa3",
            "displayFolder": "Textes",
            "description": "« réparties sur n projet(s) »."
          },
          {
            "name": "Sous-titre lignes terminées",
            "expression": [
              "IF (",
              "    [Périmètre en vigueur] = \"Tous les projets\",",
              "    \"dont \" & [Lignes terminées] & \" ligne(s) terminée(s)\",",
              "    [Lignes terminées] & \" ligne(s) terminée(s) non comptée(s)\"",
              ")"
            ],
            "lineageTag": "b1a0f952-2ce4-5df2-a44e-b5506ae26785",
            "displayFolder": "Textes",
            "description": "Lignes terminées comptées ou non selon le périmètre."
          },
          {
            "name": "Sous-titre avancement",
            "expression": "\"Moyenne simple par affaire : \" & FORMAT ( ROUND ( [Avancement moyen simple] * 100, 0 ), \"0\" ) & \" %\"",
            "lineageTag": "a5a970b0-eac8-5306-9020-0965deef2833",
            "displayFolder": "Textes",
            "description": "« Moyenne simple par affaire : x % »."
          },
          {
            "name": "Période affichée",
            "expression": [
              "VAR _d = MIN ( Mois[Mois] )",
              "VAR _f = MAX ( Mois[Mois] )",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _d ) ), \"Période \" & CALCULATE ( LOOKUPVALUE ( Mois[Mois (long)], Mois[Mois], _d ), REMOVEFILTERS ( Mois ) ) & \" – \" & CALCULATE ( LOOKUPVALUE ( Mois[Mois (long)], Mois[Mois], _f ), REMOVEFILTERS ( Mois ) ) )"
            ],
            "lineageTag": "b13f73c6-7923-58fa-b8d5-e04efb6b9d68",
            "displayFolder": "Textes",
            "description": "« Période <premier mois> – <dernier mois> » de la sélection."
          },
          {
            "name": "Texte hors période",
            "expression": [
              "VAR _h = [Charge hors période ou sans date de début (h)]",
              "RETURN",
              "    IF ( _h > 0, \"Hors période ou sans date de début : \" & FORMAT ( _h, \"#,0\", \"fr-FR\" ) & \" h\",",
              "        \"Toute la charge est visible sur la période\" )"
            ],
            "lineageTag": "12ff2766-a2c0-5d3f-8884-9d65c1179385",
            "displayFolder": "Textes",
            "description": "Charge hors période ou sans date de début (sous-titre du graphique)."
          },
          {
            "name": "Titre de la ressource",
            "expression": [
              "IF (",
              "    HASONEVALUE ( Ressources[Clé ressource] ),",
              "    \"CHARGE MENSUELLE DE \" & UPPER ( SELECTEDVALUE ( Ressources[Ressource] ) ) & \" (HEURES)\",",
              "    \"CHARGE MENSUELLE (HEURES) — choisir une ressource\"",
              ")"
            ],
            "lineageTag": "3ea38250-7119-501c-bc59-542f6233a0cd",
            "displayFolder": "Textes",
            "description": "Titre du graphique mensuel de la ressource sélectionnée."
          },
          {
            "name": "Sous-titre graphique mensuel",
            "expression": [
              "VAR _n = COUNTROWS ( VALUES ( Mois[Mois] ) )",
              "VAR _m = MIN ( Mois[Mois] )",
              "RETURN",
              "    IF ( _n > 0, _n & \" mois à partir de \" & CALCULATE ( LOOKUPVALUE ( Mois[Mois (long)], Mois[Mois], _m ), REMOVEFILTERS ( Mois ) ) )"
            ],
            "lineageTag": "4d4ab9c9-c212-523c-90de-31dd063311bb",
            "displayFolder": "Textes",
            "description": "« n mois à partir de <premier mois> » (période sélectionnée)."
          },
          {
            "name": "Sous-titre plus gros reste",
            "expression": [
              "\"sur \" & FORMAT ( [Plus gros reste à faire – total de l'affaire (h)] + 0, \"#,0\", \"fr-FR\" )",
              "    & \" h au total pour cette affaire\""
            ],
            "lineageTag": "11d09cc3-ab1b-513f-a99c-6418a8d53ce5",
            "displayFolder": "Textes",
            "description": "« sur x h au total pour cette affaire »."
          },
          {
            "name": "Origine de la ressource",
            "expression": [
              "SWITCH (",
              "    SELECTEDVALUE ( Ressources[Type de ressource] ),",
              "    \"Interne\", \"Dessinateur interne (Data, colonne E)\",",
              "    \"Externe\", \"Ressource externe (Data, colonne H)\",",
              "    \"Hors liste\", \"Absent des listes Data : réglages par défaut\",",
              "    \"Non affecté\", \"Lignes sans dessinateur ni ressource externe\",",
              "    BLANK ()",
              ")"
            ],
            "lineageTag": "322356de-e9a9-5e39-8373-801bc59fb6d5",
            "displayFolder": "Textes",
            "description": "Liste Data d'origine de la ressource sélectionnée."
          },
          {
            "name": "Sous-titre charge fixe de la ressource",
            "expression": [
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _f ) ), \"dont \" & FORMAT ( _f, \"#,0\", \"fr-FR\" ) & \" h de charge fixe\" )"
            ],
            "lineageTag": "4562ce85-9c9d-5d52-8d34-dcbe40d5666f",
            "displayFolder": "Textes",
            "description": "« dont x h de charge fixe »."
          },
          {
            "name": "Sous-titre capacité de la ressource",
            "expression": [
              "VAR _c = [Capacité de la ressource (h/mois)]",
              "VAR _f = [Charge fixe de la ressource (h/mois)]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _c ) ),",
              "        IF (",
              "            _f >= _c,",
              "            \"Attention : charge fixe ≥ capacité\",",
              "            \"soit \" & FORMAT ( [Capacité projets de la ressource (h/mois)], \"#,0\", \"fr-FR\" ) & \" h/mois pour les projets\"",
              "        )",
              "    )"
            ],
            "lineageTag": "39d3d0f4-d786-5e90-ad52-303a34d1f22a",
            "displayFolder": "Textes",
            "description": "« soit x h/mois pour les projets » ou alerte si la charge fixe atteint la capacité."
          },
          {
            "name": "Sous-titre affaires de la ressource",
            "expression": "\"sur \" & [Nombre d'affaires] & \" affaire(s)\"",
            "lineageTag": "47a05309-e437-5b54-a123-9a315411ee9b",
            "displayFolder": "Textes",
            "description": "« sur n affaire(s) »."
          },
          {
            "name": "Sous-titre charge sur la période",
            "expression": "\"dont \" & FORMAT ( [Charge répartie (h)], \"#,0\", \"fr-FR\" ) & \" h sur la période\"",
            "lineageTag": "348de76d-0891-5b81-b311-054816a156cd",
            "displayFolder": "Textes",
            "description": "« dont x h sur la période » (mois sélectionnés)."
          },
          {
            "name": "Sous-titre lignes de la ressource",
            "expression": [
              "VAR _n = [Nombre de lignes]",
              "RETURN",
              "    IF (",
              "        _n = 0,",
              "        \"Aucune affaire affectée à cette ressource dans le périmètre.\",",
              "        _n & \" ligne(s) dans le périmètre · heures sur la période = mois sélectionnés (0 sans date de début)\"",
              "    )"
            ],
            "lineageTag": "55375f55-2dbe-5f38-90d5-ebc939856572",
            "displayFolder": "Textes",
            "description": "Nombre de lignes de la ressource dans le périmètre, ou « Aucune affaire affectée à cette ressource dans le périmètre. » (comme l'onglet Dessinateurs)."
          },
          {
            "name": "Titre info-bulle projet",
            "expression": [
              "VAR _m = IF ( HASONEVALUE ( Mois[Mois] ), VALUES ( Mois[Mois] ) )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _m ),",
              "        \"Projet survolé · période affichée\",",
              "        \"Projet survolé · \" & CALCULATE ( LOOKUPVALUE ( Mois[Mois (long)], Mois[Mois], _m ), REMOVEFILTERS ( Mois ) )",
              "    )"
            ],
            "lineageTag": "6e8047ee-6452-5aa7-84d8-0dc8b0586df9",
            "displayFolder": "Textes",
            "description": "Titre de l'info-bulle projet : mois survolé, ou toute la période affichée (anneau, tableau des projets)."
          },
          {
            "name": "Mois le plus chargé de la ressource (texte)",
            "expression": [
              "VAR _m = [Mois le plus chargé de la ressource]",
              "RETURN",
              "    IF (",
              "        ISBLANK ( _m ) || [Charge répartie (h)] = 0,",
              "        \"—\",",
              "        CALCULATE ( LOOKUPVALUE ( Mois[Mois (long)], Mois[Mois], _m ), REMOVEFILTERS ( Mois ) )",
              "    )"
            ],
            "lineageTag": "82fbff51-efd6-5c95-9a72-7df5c362f4f3",
            "displayFolder": "Textes",
            "description": "Mois le plus chargé, « — » sans charge projets sur la période."
          },
          {
            "name": "Sous-titre pic de la ressource",
            "expression": [
              "VAR _p = [Charge au pic de la ressource (h)]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _p ) ), FORMAT ( _p, \"#,0\", \"fr-FR\" ) & \" h au total (fixe + projets)\" )"
            ],
            "lineageTag": "ad1b6287-a2e6-5f8d-8e5e-e2fedfad1a14",
            "displayFolder": "Textes",
            "description": "« x h au total (fixe + projets) »."
          },
          {
            "name": "Sous-titre occupation au pic",
            "expression": [
              "VAR _o = [Occupation au pic de la ressource (%)]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _o ) ), FORMAT ( ROUND ( _o * 100, 0 ), \"0\" ) & \" % de la capacité\" )"
            ],
            "lineageTag": "8deabe08-4a87-5eea-acab-c8319452efc2",
            "displayFolder": "Textes",
            "description": "« x % de la capacité »."
          },
          {
            "name": "Sous-titre dépassement cumulé",
            "expression": [
              "VAR _d = [Dépassement cumulé (h)]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _d ) ), \"Dépassement cumulé : \" & FORMAT ( _d, \"#,0\", \"fr-FR\" ) & \" h\" )"
            ],
            "lineageTag": "1fb5242e-e35e-5b6d-a9df-3b2fcfce503c",
            "displayFolder": "Textes",
            "description": "« Dépassement cumulé : x h »."
          },
          {
            "name": "Sous-titre surcharge de la ressource",
            "expression": [
              "VAR _n = [Mois en surcharge de la ressource]",
              "VAR _m = [Premier mois en surcharge de la ressource]",
              "RETURN",
              "    IF (",
              "        NOT ( ISBLANK ( _n ) ),",
              "        IF ( _n = 0, \"Aucun dépassement prévu\", \"Dès \" & CALCULATE ( LOOKUPVALUE ( Mois[Mois (long)], Mois[Mois], _m ), REMOVEFILTERS ( Mois ) ) )",
              "    )"
            ],
            "lineageTag": "3d91861c-7e71-5cf9-81a8-9c14f9cb064c",
            "displayFolder": "Textes",
            "description": "« Aucun dépassement prévu » ou « Dès <mois> »."
          },
          {
            "name": "Sous-titre heures disponibles",
            "expression": [
              "VAR _d = [Heures encore disponibles (h)]",
              "RETURN",
              "    IF ( NOT ( ISBLANK ( _d ) ), FORMAT ( _d, \"#,0\", \"fr-FR\" ) & \" h encore disponibles\" )"
            ],
            "lineageTag": "b1b2e88e-0580-5953-a29b-266e059d68ab",
            "displayFolder": "Textes",
            "description": "« x h encore disponibles »."
          },
          {
            "name": "Valeur Power BI",
            "expression": [
              "VAR _code = SELECTEDVALUE ( 'Contrôle Excel'[Code] )",
              "VAR _mois = SELECTEDVALUE ( 'Contrôle Excel'[Mois] )",
              "RETURN",
              "    CALCULATE (",
              "        SWITCH (",
              "            _code,",
              "            \"total\", [Charge identifiée (h)],",
              "            \"nbAff\", [Nombre d'affaires],",
              "            \"nbChefs\", [Nombre de chefs de projet],",
              "            \"nbProj\", [Nombre de projets],",
              "            \"nbTypes\", [Nombre de types],",
              "            \"realise\", [Réalisé (h)],",
              "            \"reste\", [Reste à faire (h)],",
              "            \"avgSimple\", [Avancement moyen simple],",
              "            \"avgPond\", [Avancement moyen pondéré],",
              "            \"periode\", [Charge répartie (h)],",
              "            \"hors\", [Charge hors période ou sans date de début (h)],",
              "            \"pic\", [Pic de charge (h)],",
              "            \"picActives\", [Affaires actives au pic],",
              "            \"picETP\", [ETP au pic],",
              "            \"totalETP\", [ETP-mois],",
              "            \"nbTermines\", [Lignes terminées],",
              "            \"picPart\", [Part du pic dans la période],",
              "            \"capEquipe\", [Capacité projets de l'équipe (h/mois)],",
              "            \"nbSurcharge\", [Mois en surcharge],",
              "            \"picCap\", [Pic en % de la capacité],",
              "            \"nbRetard\", [Affaires en retard],",
              "            \"nbDepasse\", [Affaires hors délai],",
              "            \"nbEcart\", [Affaires en écart],",
              "            \"mois\", CALCULATE ( [Charge répartie (h)], Mois[Mois] = _mois ),",
              "            BLANK ()",
              "        ),",
              "        REMOVEFILTERS ( Lignes ),",
              "        REMOVEFILTERS ( Affaires ),",
              "        REMOVEFILTERS ( Ressources ),",
              "        REMOVEFILTERS ( 'Charge mensuelle' ),",
              "        REMOVEFILTERS ( Mois ),",
              "        'Périmètre'[Périmètre] = \"Comme dans Excel\",",
              "        'Répartition'[Répartition] = \"Comme dans Excel\",",
              "        Mois[Période] = \"12 mois du Dashboard Excel\"",
              "    )"
            ],
            "lineageTag": "7882fb2c-1197-5166-8e7c-fb339efe1665",
            "displayFolder": "Contrôle",
            "description": "Valeur numérique recalculée par Power BI avec les réglages Excel sur les 12 mois du Dashboard Excel.",
            "formatString": "#,0.00"
          },
          {
            "name": "Mois Power BI",
            "expression": [
              "VAR _code = SELECTEDVALUE ( 'Contrôle Excel'[Code] )",
              "RETURN",
              "    CALCULATE (",
              "        SWITCH (",
              "            _code,",
              "            \"autoStart\", MAX ( 'Réglages'[1er mois automatique] ),",
              "            \"start\", [Premier mois affiché],",
              "            \"picMois\", [Mois du pic],",
              "            \"finPeriode\", [Dernier mois affiché],",
              "            \"premSurcharge\", [Premier mois en surcharge],",
              "            BLANK ()",
              "        ),",
              "        REMOVEFILTERS ( Lignes ),",
              "        REMOVEFILTERS ( Affaires ),",
              "        REMOVEFILTERS ( Ressources ),",
              "        REMOVEFILTERS ( 'Charge mensuelle' ),",
              "        REMOVEFILTERS ( Mois ),",
              "        'Périmètre'[Périmètre] = \"Comme dans Excel\",",
              "        'Répartition'[Répartition] = \"Comme dans Excel\",",
              "        Mois[Période] = \"12 mois du Dashboard Excel\"",
              "    )"
            ],
            "lineageTag": "936ae168-aeff-5493-bc31-1d7f83787876",
            "displayFolder": "Contrôle",
            "description": "Mois recalculé par Power BI (indicateurs de type Mois).",
            "formatString": "mmmm yyyy"
          },
          {
            "name": "Texte Power BI",
            "expression": [
              "VAR _code = SELECTEDVALUE ( 'Contrôle Excel'[Code] )",
              "RETURN",
              "    CALCULATE (",
              "        SWITCH (",
              "            _code,",
              "            \"periodeTxt\", [Période affichée],",
              "            \"reglagesTxt\", SELECTEDVALUE ( 'Réglages'[Rappel des réglages (Excel)] ),",
              "            BLANK ()",
              "        ),",
              "        REMOVEFILTERS ( Lignes ),",
              "        REMOVEFILTERS ( Affaires ),",
              "        REMOVEFILTERS ( Ressources ),",
              "        REMOVEFILTERS ( 'Charge mensuelle' ),",
              "        REMOVEFILTERS ( Mois ),",
              "        'Périmètre'[Périmètre] = \"Comme dans Excel\",",
              "        'Répartition'[Répartition] = \"Comme dans Excel\",",
              "        Mois[Période] = \"12 mois du Dashboard Excel\"",
              "    )"
            ],
            "lineageTag": "c4f1d063-e795-5673-9505-1b330af861af",
            "displayFolder": "Contrôle",
            "description": "Texte recalculé par Power BI (indicateurs de type Texte)."
          },
          {
            "name": "Valeur Excel",
            "expression": "SUM ( 'Contrôle Excel'[Valeur lue] )",
            "lineageTag": "78e756e3-f0d9-54d2-9ea5-49f668e2478d",
            "displayFolder": "Contrôle",
            "description": "Valeur lue dans l'onglet Calculs.",
            "formatString": "#,0.00"
          },
          {
            "name": "Écart",
            "expression": [
              "VAR _n = SELECTEDVALUE ( 'Contrôle Excel'[Nature] )",
              "RETURN",
              "    IF ( _n IN { \"Heures\", \"Nombre\", \"Décimal\", \"Pourcentage\" }, [Valeur Power BI] - [Valeur Excel] )"
            ],
            "lineageTag": "a95f2825-2363-5787-8354-484a525eea13",
            "displayFolder": "Contrôle",
            "description": "Power BI - Excel (indicateurs numériques).",
            "formatString": "#,0.00"
          },
          {
            "name": "Excel (affiché)",
            "expression": [
              "VAR _n = SELECTEDVALUE ( 'Contrôle Excel'[Nature] )",
              "VAR _v = [Valeur Excel]",
              "RETURN",
              "    SWITCH (",
              "        _n,",
              "        \"Texte\", SELECTEDVALUE ( 'Contrôle Excel'[Valeur lue (texte)] ),",
              "        \"Mois\", SELECTEDVALUE ( 'Contrôle Excel'[Valeur lue (texte)] ),",
              "        \"Pourcentage\", IF ( ISBLANK ( _v ), \"\", FORMAT ( _v, \"0.0 %\", \"fr-FR\" ) ),",
              "        \"Heures\", FORMAT ( _v, \"#,0.0\", \"fr-FR\" ),",
              "        \"Décimal\", FORMAT ( _v, \"0.00\", \"fr-FR\" ),",
              "        FORMAT ( _v, \"0\", \"fr-FR\" )",
              "    )"
            ],
            "lineageTag": "8e7839be-d984-5fe0-9080-cc70b84a12e6",
            "displayFolder": "Contrôle",
            "description": "Valeur Excel mise en forme."
          },
          {
            "name": "Power BI (affiché)",
            "expression": [
              "VAR _n = SELECTEDVALUE ( 'Contrôle Excel'[Nature] )",
              "VAR _v = [Valeur Power BI]",
              "VAR _m = [Mois Power BI]",
              "RETURN",
              "    SWITCH (",
              "        _n,",
              "        \"Texte\", [Texte Power BI],",
              "        \"Mois\", IF ( ISBLANK ( _m ), \"\", FORMAT ( _m, \"mmm yyyy\", \"fr-FR\" ) ),",
              "        \"Pourcentage\", IF ( ISBLANK ( _v ), \"\", FORMAT ( _v, \"0.0 %\", \"fr-FR\" ) ),",
              "        \"Heures\", FORMAT ( _v, \"#,0.0\", \"fr-FR\" ),",
              "        \"Décimal\", FORMAT ( _v, \"0.00\", \"fr-FR\" ),",
              "        FORMAT ( _v, \"0\", \"fr-FR\" )",
              "    )"
            ],
            "lineageTag": "ade2ee6d-20a4-5087-8d98-09938019d02a",
            "displayFolder": "Contrôle",
            "description": "Valeur Power BI mise en forme."
          },
          {
            "name": "Statut du contrôle",
            "expression": [
              "VAR _n = SELECTEDVALUE ( 'Contrôle Excel'[Nature] )",
              "VAR _tol = SELECTEDVALUE ( 'Contrôle Excel'[Tolérance] )",
              "VAR _pbi = [Valeur Power BI]",
              "VAR _xl = [Valeur Excel]",
              "VAR _ok =",
              "    SWITCH (",
              "        _n,",
              "        \"Texte\", [Texte Power BI] = SELECTEDVALUE ( 'Contrôle Excel'[Valeur lue (texte)] ),",
              "        \"Mois\", [Mois Power BI] = SELECTEDVALUE ( 'Contrôle Excel'[Mois] ),",
              "        IF (",
              "            ISBLANK ( _pbi ) && ISBLANK ( _xl ),",
              "            TRUE (),",
              "            IF ( ISBLANK ( _pbi ) || ISBLANK ( _xl ), FALSE (), ABS ( _pbi - _xl ) <= _tol )",
              "        )",
              "    )",
              "RETURN",
              "    IF ( ISBLANK ( _n ), BLANK (), IF ( _ok, \"✔\", \"✘\" ) )"
            ],
            "lineageTag": "29290967-dcd5-5d63-80e7-1a5b5a26425d",
            "displayFolder": "Contrôle",
            "description": "✔ si Power BI et Excel concordent (tolérance de la ligne), sinon ✘."
          },
          {
            "name": "Contrôles en écart",
            "expression": "COUNTROWS ( FILTER ( VALUES ( 'Contrôle Excel'[Ordre] ), [Statut du contrôle] = \"✘\" ) ) + 0",
            "lineageTag": "5b7f6dc3-ccad-597c-abef-6a08e57b0758",
            "displayFolder": "Contrôle",
            "description": "Nombre de contrôles ✘.",
            "formatString": "0"
          }
        ]
      }
    ],
