        "partitions": [
          {
            "name": "Réglages",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    P = ParamètresExcel,",
                "    F = FenêtreExcel,",
                "    Noms = NomsDesMois,",
                "    MoisLong = (d as date) as text => Noms[Longs]{Date.Month(d) - 1} & \" \" & Text.From(Date.Year(d)),",
                "    Équipe = Table.SelectRows(Ressources, each [#\"Dans l'équipe\"]),",
                "    SommeÉquipe = List.Sum(Équipe[#\"Capacité projets (h/mois)\"]),",
                "    RappelCapacité = P[#\"Capacité (texte)\"] & \" h/pers. dont \" & P[#\"Charge fixe (texte)\"] & \" h hors projet\",",
                "    Rappel = P[#\"Périmètre Excel\"] & \"  ·  \"",
                "        & (if P[#\"Lissée\"] then \"lissage en jours ouvrés jusqu'au besoin\" else \"tout sur le mois de début\")",
                "        & \"  ·  \" & RappelCapacité,",
                "    Résultat = #table(",
                "        {\"Périmètre Excel\", \"Répartition Excel\", \"Périmètre appliqué (Excel)\", \"Répartition appliquée (Excel)\",",
                "            \"1er mois saisi\", \"1er mois automatique\", \"1er mois affiché (Excel)\", \"Dernier mois affiché (Excel)\",",
                "            \"Période affichée (Excel)\", \"Capacité par défaut (h/mois)\", \"Charge fixe par défaut (h/mois)\",",
                "            \"Capacité projets par personne (Excel)\", \"Capacité projets de l'équipe (Excel)\", \"Rappel capacité\",",
                "            \"Rappel des réglages (Excel)\", \"Lignes valides (Excel)\", \"Lignes terminées (Excel)\",",
                "            \"Lignes à corriger (Excel)\"},",
                "        {{",
                "            P[#\"Périmètre Excel\"],",
                "            P[#\"Répartition Excel\"],",
                "            if P[#\"Tous les projets\"] then \"Tous les projets\" else \"Projets en cours\",",
                "            if P[#\"Lissée\"] then \"Lissée jusqu'à la date de besoin\" else \"Tout sur le mois de début\",",
                "            P[#\"Premier mois saisi\"],",
                "            F[#\"1er mois automatique\"],",
                "            F[#\"1er mois affiché\"],",
                "            F[#\"Dernier mois affiché\"],",
                "            \"Période \" & MoisLong(F[#\"1er mois affiché\"]) & \" – \" & MoisLong(F[#\"Dernier mois affiché\"]),",
                "            P[#\"Capacité par défaut\"],",
                "            P[#\"Charge fixe par défaut\"],",
                "            P[#\"Capacité par défaut\"] - P[#\"Charge fixe par défaut\"],",
                "            if SommeÉquipe = null then 0 else SommeÉquipe,",
                "            RappelCapacité,",
                "            Rappel,",
                "            Table.RowCount(DonnéesCharge),",
                "            Table.RowCount(Table.SelectRows(DonnéesCharge, each [Terminée])),",
                "            Table.RowCount(Table.SelectRows(DonnéesCharge, each [Dessinateur et externe]))",
                "        }}),",
                "    Sélection = Table.SelectColumns(Résultat, {\"Périmètre Excel\", \"Répartition Excel\", \"Périmètre appliqué (Excel)\", \"Répartition appliquée (Excel)\", \"1er mois saisi\", \"1er mois automatique\", \"1er mois affiché (Excel)\", \"Dernier mois affiché (Excel)\", \"Période affichée (Excel)\", \"Capacité par défaut (h/mois)\", \"Charge fixe par défaut (h/mois)\", \"Capacité projets par personne (Excel)\", \"Capacité projets de l'équipe (Excel)\", \"Rappel capacité\", \"Rappel des réglages (Excel)\", \"Lignes valides (Excel)\", \"Lignes terminées (Excel)\", \"Lignes à corriger (Excel)\"}, MissingField.UseNull),",
                "    Typée = Table.TransformColumnTypes(Sélection, {{\"Périmètre Excel\", type text}, {\"Répartition Excel\", type text}, {\"Périmètre appliqué (Excel)\", type text}, {\"Répartition appliquée (Excel)\", type text}, {\"1er mois saisi\", type date}, {\"1er mois automatique\", type date}, {\"1er mois affiché (Excel)\", type date}, {\"Dernier mois affiché (Excel)\", type date}, {\"Période affichée (Excel)\", type text}, {\"Capacité par défaut (h/mois)\", type number}, {\"Charge fixe par défaut (h/mois)\", type number}, {\"Capacité projets par personne (Excel)\", type number}, {\"Capacité projets de l'équipe (Excel)\", type number}, {\"Rappel capacité\", type text}, {\"Rappel des réglages (Excel)\", type text}, {\"Lignes valides (Excel)\", Int64.Type}, {\"Lignes terminées (Excel)\", Int64.Type}, {\"Lignes à corriger (Excel)\", Int64.Type}})",
                "in",
                "    Typée"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
      {
