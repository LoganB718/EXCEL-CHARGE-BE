        "partitions": [
          {
            "name": "Lignes",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = LignesPérimètres,",
                "    Clés = Table.SelectColumns(Ressources, {\"Clé ressource (texte)\", \"Clé ressource\"}),",
                "    Jointes = Table.NestedJoin(Source, {\"Clé ressource (texte)\"}, Clés, {\"Clé ressource (texte)\"}, \"Jointure ressource\",",
                "        JoinKind.LeftOuter),",
                "    AvecRessource = Table.ExpandTableColumn(Jointes, \"Jointure ressource\", {\"Clé ressource\"}),",
                "    AjoutReste = Table.AddColumn(AvecRessource, \"Reste de la ligne (h)\",",
                "        each [#\"Heures (h)\"] - [#\"Réalisé de la ligne (h)\"], type number),",
                "    AjoutSansDébut = Table.AddColumn(AjoutReste, \"Sans date de début\", each [#\"Début planifié\"] = null, type logical),",
                "    AjoutDébutAffiché = Table.AddColumn(AjoutSansDébut, \"Début (affiché)\",",
                "        each if [#\"Début planifié\"] = null then \"—\"",
                "            else Text.PadStart(Text.From(Date.Day([#\"Début planifié\"])), 2, \"0\") & \"/\"",
                "                & Text.PadStart(Text.From(Date.Month([#\"Début planifié\"])), 2, \"0\") & \"/\"",
                "                & Text.From(Date.Year([#\"Début planifié\"])), type text),",
                "    Résultat = AjoutDébutAffiché,",
                "    Sélection = Table.SelectColumns(Résultat, {\"Clé ligne\", \"Clé affaire\", \"Clé ressource\", \"Périmètre\", \"N° ligne\", \"Chef de projet\", \"Projet\", \"Sous-projet\", \"Produit\", \"Type\", \"Description\", \"Contraintes\", \"Autres informations\", \"Coordinateur\", \"Dessinateur\", \"Ressource externe\", \"Ressource de la ligne\", \"Type de ressource\", \"Dessinateur et externe\", \"Heures (h)\", \"Avancement\", \"Réalisé de la ligne (h)\", \"Reste de la ligne (h)\", \"Début planifié\", \"Début (affiché)\", \"Date de besoin\", \"Terminée\", \"Sans date de début\", \"Rang chef\", \"Rang projet\", \"Rang type\", \"Rang ligne\", \"Groupe projet\", \"Ordre groupe projet\", \"Couleur projet\", \"Clé affaire (texte)\"}, MissingField.UseNull),",
                "    Typée = Table.TransformColumnTypes(Sélection, {{\"Clé ligne\", Int64.Type}, {\"Clé affaire\", Int64.Type}, {\"Clé ressource\", Int64.Type}, {\"Périmètre\", type text}, {\"N° ligne\", Int64.Type}, {\"Chef de projet\", type text}, {\"Projet\", type text}, {\"Sous-projet\", type text}, {\"Produit\", type text}, {\"Type\", type text}, {\"Description\", type text}, {\"Contraintes\", type text}, {\"Autres informations\", type text}, {\"Coordinateur\", type text}, {\"Dessinateur\", type text}, {\"Ressource externe\", type text}, {\"Ressource de la ligne\", type text}, {\"Type de ressource\", type text}, {\"Dessinateur et externe\", type logical}, {\"Heures (h)\", type number}, {\"Avancement\", type number}, {\"Réalisé de la ligne (h)\", type number}, {\"Reste de la ligne (h)\", type number}, {\"Début planifié\", type date}, {\"Début (affiché)\", type text}, {\"Date de besoin\", type date}, {\"Terminée\", type logical}, {\"Sans date de début\", type logical}, {\"Rang chef\", Int64.Type}, {\"Rang projet\", Int64.Type}, {\"Rang type\", Int64.Type}, {\"Rang ligne\", Int64.Type}, {\"Groupe projet\", type text}, {\"Ordre groupe projet\", Int64.Type}, {\"Couleur projet\", type text}, {\"Clé affaire (texte)\", type text}})",
                "in",
                "    Typée"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_ResultType",
            "value": "Table"
          },
          {
            "name": "PBI_NavigationStepName",
            "value": "Navigation"
          }
        ]
      },
